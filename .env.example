# Copy to .env for local development. On the VPS, .env lives only there (see deploy workflow).

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://shiftsync:shiftsync@localhost:5432/shiftsync?schema=public"

# Redis (BullMQ queues)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="7d"

# SMTP (real email sending — see DECISIONS.md)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="username"
SMTP_PASSWORD="password"
MAIL_FROM="ShiftSync <no-reply@shiftsync.example.com>"

# Business rules (overridable defaults — see spec)
DEFAULT_PUBLISH_CUTOFF_HOURS=48
MIN_REST_HOURS=10
DAILY_HOURS_WARNING=8
DAILY_HOURS_HARD_BLOCK=12
WEEKLY_HOURS_WARNING=35
WEEKLY_HOURS_OVERTIME=40
DROP_REQUEST_EXPIRY_HOURS_BEFORE_SHIFT=24
MAX_PENDING_SWAP_REQUESTS_PER_STAFF=3
